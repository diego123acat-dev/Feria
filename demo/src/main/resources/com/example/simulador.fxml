<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="820.0" prefWidth="1400.0"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.controller.SimuladorController">

    <!-- ================= TOP BAR ================= -->

    <top>
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              style="-fx-background-color: #111827;
                     -fx-padding: 18;
                     -fx-border-color: #1F2937;
                     -fx-border-width: 0 0 2 0;">

            <Label text="KernelSim">
                <font>
                    <Font size="28"/>
                </font>
                <style>
                    -fx-text-fill: white;
                    -fx-font-weight: bold;
                </style>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Algoritmo:"
                   style="-fx-text-fill: #D1D5DB;
                          -fx-font-size: 15;" />

            <ComboBox fx:id="comboAlgoritmo"
                      prefWidth="180"/>

            <Label text="Quantum:"
                   style="-fx-text-fill: #D1D5DB;
                          -fx-font-size: 15;" />

            <Spinner fx:id="spinnerQuantum"
                     prefWidth="90"/>

            <Button fx:id="btnIniciar"
                    text="Iniciar"
                    style="-fx-background-color: #10B981;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;" />

            <Button fx:id="btnPausar"
                    text="Pausar"
                    style="-fx-background-color: #F59E0B;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;" />

            <Button fx:id="btnDetener"
                    text="Detener"
                    style="-fx-background-color: #EF4444;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;" />
            
            <Button fx:id="btnAgregarProceso"
        text="+ Proceso"
        style="-fx-background-color: #3B82F6;
               -fx-text-fill: white;
               -fx-font-weight: bold;
               -fx-background-radius: 10;" />

        </HBox>
    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="20"
              style="-fx-background-color: #0F172A;
                     -fx-padding: 20;">

            <!-- ================= CPU PANEL ================= -->

            <VBox spacing="15"
                  style="-fx-background-color: #111827;
                         -fx-background-radius: 18;
                         -fx-padding: 20;
                         -fx-border-color: #1E293B;
                         -fx-border-radius: 18;">

                <Label text="CPU"
                       style="-fx-text-fill: white;
                              -fx-font-size: 24;
                              -fx-font-weight: bold;" />

                <HBox spacing="20"
                      alignment="CENTER_LEFT">

                    <VBox spacing="10">

                        <Label text="Proceso en ejecución"
                               style="-fx-text-fill: #9CA3AF;
                                      -fx-font-size: 15;" />

                        <Label fx:id="lblProcesoActual"
                               text="IDLE"
                               style="-fx-text-fill: #10B981;
                                      -fx-font-size: 32;
                                      -fx-font-weight: bold;" />
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox spacing="10">

                        <Label text="Quantum"
                               style="-fx-text-fill: #9CA3AF;
                                      -fx-font-size: 15;" />

                        <ProgressBar fx:id="progressQuantum"
                                     prefWidth="250"
                                     progress="0.0"/>
                    </VBox>

                </HBox>

            </VBox>

            <!-- ================= QUEUES ================= -->

            <HBox spacing="20"
                  prefHeight="260"
                  minHeight="220"
                  maxHeight="280">

                <!-- READY -->

                <VBox spacing="12"
                      prefWidth="400"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #111827;
                             -fx-background-radius: 18;
                             -fx-padding: 18;">

                    <Label text="READY QUEUE"
                           style="-fx-text-fill: #60A5FA;
                                  -fx-font-size: 22;
                                  -fx-font-weight: bold;" />

                    <ListView fx:id="listReady"
                              prefHeight="160"
                              VBox.vgrow="ALWAYS"
                              style="-fx-background-color: #1F2937;
                                     -fx-control-inner-background: #1F2937;
                                     -fx-text-fill: white;" />

                </VBox>

                <!-- BLOCKED -->

                <VBox spacing="12"
                      prefWidth="400"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #111827;
                             -fx-background-radius: 18;
                             -fx-padding: 18;">

                    <Label text="BLOCKED QUEUE"
                           style="-fx-text-fill: #F59E0B;
                                  -fx-font-size: 22;
                                  -fx-font-weight: bold;" />

                    <ListView fx:id="listBlocked"
                              prefHeight="160"
                              VBox.vgrow="ALWAYS"
                              style="-fx-background-color: #1F2937;
                                     -fx-control-inner-background: #1F2937;" />

                </VBox>

                <!-- FINISHED -->

                <VBox spacing="12"
                      prefWidth="400"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #111827;
                             -fx-background-radius: 18;
                             -fx-padding: 18;">

                    <Label text="FINISHED"
                           style="-fx-text-fill: #10B981;
                                  -fx-font-size: 22;
                                  -fx-font-weight: bold;" />

                    <ListView fx:id="listFinished"
                              prefHeight="160"
                              VBox.vgrow="ALWAYS"
                              style="-fx-background-color: #1F2937;
                                     -fx-control-inner-background: #1F2937;" />

                </VBox>

            </HBox>

            <!-- ================= TABLE ================= -->

            <VBox spacing="15"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #111827;
                         -fx-background-radius: 18;
                         -fx-padding: 20;">

                <Label text="TABLA DE PROCESOS"
                       style="-fx-text-fill: white;
                              -fx-font-size: 22;
                              -fx-font-weight: bold;" />

                <TableView fx:id="tablaProcesos"
                           prefHeight="420"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colPID"
                                     text="PID"
                                     prefWidth="80"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="150"/>

                        <TableColumn fx:id="colEstado"
                                     text="Estado"
                                     prefWidth="180"/>

                        <TableColumn fx:id="colTiempoTotal"
                                     text="Tiempo Total"
                                     prefWidth="150"/>

                        <TableColumn fx:id="colTiempoRestante"
                                     text="Tiempo Restante"
                                     prefWidth="170"/>

                        <TableColumn fx:id="colPrioridad"
                                     text="Prioridad"
                                     prefWidth="120"/>

                        <TableColumn fx:id="colLlegada"
                                     text="Llegada"
                                     prefWidth="120"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

    <!-- ================= BOTTOM ================= -->

    <bottom>

        <HBox spacing="40"
              alignment="CENTER_LEFT"
              style="-fx-background-color: #111827;
                     -fx-padding: 18;
                     -fx-border-color: #1F2937;
                     -fx-border-width: 2 0 0 0;">

            <Label fx:id="lblTiempoSistema"
                   text="Tiempo Sistema: 0"
                   style="-fx-text-fill: white;
                          -fx-font-size: 16;
                          -fx-font-weight: bold;" />

            <Label fx:id="lblProcesosActivos"
                   text="Procesos Activos: 0"
                   style="-fx-text-fill: white;
                          -fx-font-size: 16;
                          -fx-font-weight: bold;" />

            <Label fx:id="lblCPU"
                   text="Uso CPU: 0%"
                   style="-fx-text-fill: white;
                          -fx-font-size: 16;
                          -fx-font-weight: bold;" />

        </HBox>

    </bottom>

</BorderPane>
