<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1050.0"
            prefHeight="680.0"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.controller.SimuladorController"
            style="-fx-background-color: #F3F4F6;">

    <top>
        <VBox spacing="8"
              style="-fx-background-color: white; -fx-border-color: #D1D5DB; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="10" right="12" bottom="10" left="12"/>
            </padding>

            <Label text="Simulador de Planificacion de CPU"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Algoritmo:"/>
                <ComboBox fx:id="comboAlgoritmo" prefWidth="145"/>

                <Label text="Quantum:"/>
                <Spinner fx:id="spinnerQuantum" prefWidth="75"/>

                <Separator orientation="VERTICAL"/>

                <Button fx:id="btnAgregarProceso" text="+ Proceso"/>
                <Button fx:id="btnGenerar" text="Generar 10"/>

                <Separator orientation="VERTICAL"/>

                <Button fx:id="btnIniciar" text="Iniciar"
                        style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="btnPausar" text="Pausar"/>
                <Button fx:id="btnDetener" text="Reiniciar"
                        style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblTiempo" text="Tiempo: 0"
                       style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <Label fx:id="lblCPU" text="CPU: 0%"
                       style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="10" prefWidth="310.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #D1D5DB; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <VBox spacing="6">
                <Label text="CPU" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Ejecutando:"/>
                    <Label fx:id="lblProcesoActual" text="IDLE"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                </HBox>
                <Label text="Progreso de quantum"/>
                <ProgressBar fx:id="progressQuantum" prefWidth="285" progress="0.0"/>
            </VBox>

            <Separator/>

            <HBox spacing="8" VBox.vgrow="ALWAYS">
                <VBox spacing="4" prefWidth="92" HBox.hgrow="ALWAYS">
                    <Label text="Ready" style="-fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                    <ListView fx:id="listReady" prefHeight="150"/>
                </VBox>
                <VBox spacing="4" prefWidth="92" HBox.hgrow="ALWAYS">
                    <Label text="Blocked" style="-fx-font-weight: bold; -fx-text-fill: #D97706;"/>
                    <ListView fx:id="listBlocked" prefHeight="150"/>
                </VBox>
                <VBox spacing="4" prefWidth="92" HBox.hgrow="ALWAYS">
                    <Label text="Done" style="-fx-font-weight: bold; -fx-text-fill: #16A34A;"/>
                    <ListView fx:id="listFinished" prefHeight="150"/>
                </VBox>
            </HBox>

            <Separator/>

            <Label text="Procesos" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
            <TableView fx:id="tablaProcesos" prefHeight="285" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPID" text="PID" prefWidth="45"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="85"/>
                    <TableColumn fx:id="colLlegada" text="Lleg." prefWidth="55"/>
                    <TableColumn fx:id="colTiempoTotal" text="Total" prefWidth="55"/>
                    <TableColumn fx:id="colTiempoRestante" text="Rest." prefWidth="55"/>
                </columns>
            </TableView>
        </VBox>
    </left>

    <center>
        <VBox spacing="8">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <Label text="Diagrama de Gantt"
                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #4B5563;"/>
            <Label text="Cada fila es un proceso. Cada columna es una unidad de tiempo."
                   style="-fx-text-fill: #6B7280;"/>

            <ScrollPane fitToHeight="false"
                        fitToWidth="false"
                        pannable="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;">
                <content>
                    <GridPane fx:id="gridGantt"
                              hgap="3"
                              vgap="4"
                              style="-fx-background-color: white; -fx-padding: 12;"/>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
